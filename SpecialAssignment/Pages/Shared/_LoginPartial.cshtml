@using Microsoft.AspNetCore.Identity
@using SpecialAssignment.Models
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="user-chip" title="@(User.Identity?.Name)">
        <span class="avatar" aria-hidden="true">@(User.Identity?.Name?.Trim().FirstOrDefault().ToString().ToUpperInvariant() ?? "?")</span>
        <span class="name">@(User.Identity?.Name)</span>
    </span>
    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
        <button type="submit" class="btn btn-sm btn-on-dark">Logout</button>
    </form>
}
else
{
    <a class="btn btn-sm btn-accent" asp-area="Identity" asp-page="/Account/Login">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
        Operator&nbsp;Login
    </a>
}
