<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GIS-based early warning and real-time monitoring for farmer–herder conflict response." />
    <title>@ViewData["Title"] - Early Warning Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="wordmark" asp-page="/Index" aria-label="Early Warning Monitoring home">
                <span class="wordmark-glyph" aria-hidden="true">EW</span>
                <span>Early&nbsp;Warning</span>
            </a>
            <nav class="topnav" id="topnav" aria-label="Primary">
                <a asp-page="/Report/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Report") == true ? "active" : "")">Report</a>
                <a asp-page="/Dashboard/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Dashboard") == true || ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Map") == true ? "active" : "")">Dashboard</a>
                <a asp-page="/Incidents/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Incidents") == true ? "active" : "")">Reports</a>
                <a asp-page="/Alerts/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Alerts") == true ? "active" : "")">Alerts</a>
                <a asp-page="/Admin/RiskZones/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin") == true ? "active" : "")">Risk&nbsp;Zones</a>
            </nav>
            <div class="topbar-right">
                <span class="pill pill-live d-none d-md-inline-flex" role="status"><span class="dot dot-pulse" aria-hidden="true"></span>SYSTEM&nbsp;LIVE</span>
                <partial name="_LoginPartial" />
                <button class="btn btn-sm btn-on-dark d-lg-none" id="btnTopMenu" aria-label="Open navigation" aria-expanded="false" aria-controls="topnav">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
            </div>
        </div>
    </header>
    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span class="wordmark" style="font-size:.8rem" aria-hidden="true"><span class="wordmark-glyph" style="width:22px;height:22px;font-size:.65rem">EW</span></span>
            <span>&copy; 2026 Farmer–Herder Early Warning Monitoring</span>
            <span class="mono">PATTERN: MAP-FIRST OPS · MONOCHROME + EMERALD</span>
            <span style="margin-left:auto"><a asp-page="/Privacy">Privacy</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('btnTopMenu')?.addEventListener('click', function () {
            var nav = document.getElementById('topnav');
            var open = nav.classList.toggle('mobile-open');
            this.setAttribute('aria-expanded', open);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
